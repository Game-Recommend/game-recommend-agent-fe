# 백엔드 주소. Next.js 서버(Route Handler)에서만 읽으며 브라우저에는 내려가지 않습니다.
# NEXT_PUBLIC_ 접두사를 붙이면 브라우저 번들에 포함되므로 붙이지 마세요.
BACKEND_API_URL=http://127.0.0.1:8000

# 백엔드가 X-API-Key 헤더로 검사하는 공유 비밀 키. 백엔드의 API_KEY와 같은 값을 넣습니다.
# 로컬 백엔드도 같습니다. 백엔드는 API_KEY가 비어 있으면 추천 요청에 503을, 키가 없거나 다른 요청에는
# 401을 돌려주므로(프록시가 502로 바꿉니다) 비워 두면 추천이 동작하지 않습니다.
BACKEND_API_KEY=
